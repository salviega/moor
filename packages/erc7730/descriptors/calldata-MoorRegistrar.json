{
	"$schema": "https://raw.githubusercontent.com/LedgerHQ/clear-signing-erc7730-registry/master/specs/erc7730-v1.schema.json",
	"context": {
		"$id": "MoorRegistrar",
		"contract": {
			"abi": [
				{
					"type": "function",
					"name": "createPosition",
					"inputs": [
						{
							"name": "registry",
							"type": "address",
							"internalType": "contract IPermissionedRegistry"
						},
						{
							"name": "resolver",
							"type": "address",
							"internalType": "contract PermissionedResolver"
						},
						{
							"name": "parentName",
							"type": "string",
							"internalType": "string"
						},
						{
							"name": "label",
							"type": "string",
							"internalType": "string"
						},
						{
							"name": "expiry",
							"type": "uint64",
							"internalType": "uint64"
						},
						{
							"name": "records",
							"type": "tuple[]",
							"internalType": "struct MoorRegistrar.Record[]",
							"components": [
								{
									"name": "key",
									"type": "string",
									"internalType": "string"
								},
								{
									"name": "value",
									"type": "string",
									"internalType": "string"
								}
							]
						}
					],
					"outputs": [
						{
							"name": "positionNode",
							"type": "bytes32",
							"internalType": "bytes32"
						}
					],
					"stateMutability": "nonpayable"
				},
				{
					"type": "function",
					"name": "revokeAgent",
					"inputs": [
						{
							"name": "resolver",
							"type": "address",
							"internalType": "contract PermissionedResolver"
						},
						{
							"name": "agent",
							"type": "address",
							"internalType": "address"
						}
					],
					"outputs": [],
					"stateMutability": "nonpayable"
				},
				{
					"type": "function",
					"name": "setupAgent",
					"inputs": [
						{
							"name": "registry",
							"type": "address",
							"internalType": "contract IPermissionedRegistry"
						},
						{
							"name": "resolver",
							"type": "address",
							"internalType": "contract PermissionedResolver"
						},
						{
							"name": "parentName",
							"type": "string",
							"internalType": "string"
						},
						{
							"name": "agent",
							"type": "address",
							"internalType": "address"
						},
						{
							"name": "expiry",
							"type": "uint64",
							"internalType": "uint64"
						}
					],
					"outputs": [
						{
							"name": "agentNode",
							"type": "bytes32",
							"internalType": "bytes32"
						}
					],
					"stateMutability": "nonpayable"
				}
			],
			"deployments": [
				{
					"chainId": 11155111,
					"address": "0xe6915D2E5e8Db86661a66472e5B178d0dB419966"
				}
			]
		}
	},
	"metadata": {
		"owner": "Moor",
		"info": {
			"legalName": "Moor",
			"url": "https://getmoor.vercel.app"
		},
		"constants": {}
	},
	"display": {
		"formats": {
			"createPosition(address,address,string,string,uint64,(string,string)[])": {
				"$id": "createPosition",
				"intent": "Name Moor position",
				"fields": [
					{
						"path": "label",
						"label": "Position name",
						"format": "raw"
					},
					{
						"path": "parentName",
						"label": "Under name",
						"format": "raw"
					},
					{
						"path": "expiry",
						"label": "Name expires",
						"format": "date",
						"params": {
							"encoding": "timestamp"
						}
					},
					{
						"path": "records.[]",
						"fields": [
							{
								"path": "key",
								"label": "Record",
								"format": "raw"
							},
							{
								"path": "value",
								"label": "Value",
								"format": "raw"
							}
						]
					},
					{
						"path": "registry",
						"label": "Name registry",
						"format": "addressName",
						"params": {
							"types": ["contract"],
							"sources": ["local", "ens"]
						}
					},
					{
						"path": "resolver",
						"label": "Resolver",
						"format": "addressName",
						"params": {
							"types": ["contract"],
							"sources": ["local", "ens"]
						}
					}
				],
				"required": ["label", "parentName", "expiry", "records.[]"]
			},
			"setupAgent(address,address,string,address,uint64)": {
				"$id": "setupAgent",
				"intent": "Authorize Moor agent",
				"fields": [
					{
						"path": "agent",
						"label": "Agent address",
						"format": "addressName",
						"params": {
							"types": ["eoa", "wallet"],
							"sources": ["local", "ens"]
						}
					},
					{
						"path": "parentName",
						"label": "Under name",
						"format": "raw"
					},
					{
						"path": "expiry",
						"label": "Agent name expires",
						"format": "date",
						"params": {
							"encoding": "timestamp"
						}
					},
					{
						"path": "registry",
						"label": "Name registry",
						"format": "addressName",
						"params": {
							"types": ["contract"],
							"sources": ["local", "ens"]
						}
					},
					{
						"path": "resolver",
						"label": "Resolver",
						"format": "addressName",
						"params": {
							"types": ["contract"],
							"sources": ["local", "ens"]
						}
					}
				],
				"required": ["agent", "parentName", "expiry"]
			},
			"revokeAgent(address,address)": {
				"$id": "revokeAgent",
				"intent": "Revoke Moor agent",
				"fields": [
					{
						"path": "agent",
						"label": "Agent address",
						"format": "addressName",
						"params": {
							"types": ["eoa", "wallet"],
							"sources": ["local", "ens"]
						}
					},
					{
						"path": "resolver",
						"label": "Resolver",
						"format": "addressName",
						"params": {
							"types": ["contract"],
							"sources": ["local", "ens"]
						}
					}
				],
				"required": ["agent"]
			}
		}
	}
}
