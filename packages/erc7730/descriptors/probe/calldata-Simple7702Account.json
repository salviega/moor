{
	"$schema": "https://raw.githubusercontent.com/LedgerHQ/clear-signing-erc7730-registry/master/specs/erc7730-v1.schema.json",
	"context": {
		"$id": "Simple7702Account",
		"contract": {
			"abi": [
				{
					"type": "function",
					"name": "executeBatch",
					"inputs": [
						{
							"name": "calls",
							"type": "tuple[]",
							"internalType": "struct BaseAccount.Call[]",
							"components": [
								{ "name": "target", "type": "address", "internalType": "address" },
								{ "name": "value", "type": "uint256", "internalType": "uint256" },
								{ "name": "data", "type": "bytes", "internalType": "bytes" }
							]
						}
					],
					"outputs": [],
					"stateMutability": "payable"
				}
			],
			"deployments": [
				{
					"chainId": 11155111,
					"address": "0x4Cd241E8d1510e30b2076397afc7508Ae59C66c9"
				}
			]
		}
	},
	"metadata": {
		"owner": "Moor",
		"info": {
			"legalName": "Moor",
			"url": "https://getmoor.vercel.app"
		},
		"constants": {}
	},
	"display": {
		"formats": {
			"executeBatch((address,uint256,bytes)[])": {
				"$id": "executeBatch",
				"intent": "Moor: all steps in one",
				"fields": [
					{
						"path": "calls.[].target",
						"label": "Contract",
						"format": "addressName",
						"params": {
							"types": ["contract"],
							"sources": ["local", "ens"]
						}
					},
					{
						"path": "calls.[].data",
						"label": "Call",
						"format": "calldata",
						"params": {
							"calleePath": "calls.[].target",
							"amountPath": "calls.[].value"
						}
					}
				],
				"required": ["calls.[].target", "calls.[].data"],
				"excluded": ["calls.[].value"]
			}
		}
	}
}
