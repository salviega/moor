# Copy to .env (git-ignored). Loaded with: set -a; . ./.env; set +a
# Only the deploy script reads these. The agent's secrets come from Ledger Key Ring, never from here.

# Sepolia JSON-RPC endpoint (Alchemy, Infura, or public)
SEPOLIA_RPC_URL=""
# Deployer: becomes the AquaSwapVMRouter owner. Test funds only.
DEPLOYER_ADDRESS=""
DEPLOYER_PRIVATE_KEY=""
# Optional: an existing WETH on the target chain. When empty, Deploy.s.sol deploys TestWETH.
WETH_ADDRESS=""

# Agent hot key. Dev only: on the VPS the agent reads these from Ledger Key Ring (wallet-cli ring), never from a file.
AGENT_ADDRESS=""
AGENT_PRIVATE_KEY=""
